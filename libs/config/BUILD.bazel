load("//tools/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "exceptions",
    srcs = ["exceptions.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "utils",
    srcs = ["utils.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":exceptions",
        "@pip//pyyaml",
        "@pip//tomli_w",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":exceptions",
        ":utils",
        "@pip//pydantic",
    ],
)

py_library(
    name = "extending_config",
    srcs = ["extending_config.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":config",
        ":exceptions",
        ":utils",
    ],
)

py_test(
    name = "config_test",
    srcs = ["config_test.py"],
    deps = [
        ":config",
        ":exceptions",
        "@pip//pydantic",
        "@pip//pytest",
    ],
)

py_test(
    name = "extending_config_test",
    srcs = ["extending_config_test.py"],
    deps = [
        ":exceptions",
        ":extending_config",
        "@pip//pydantic",
        "@pip//pytest",
    ],
)

py_test(
    name = "utils_test",
    srcs = ["utils_test.py"],
    deps = [
        ":exceptions",
        ":utils",
        "@pip//pytest",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
