load("//tools/python:defs.bzl", "py_library", "py_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

py_library(
    name = "io",
    srcs = ["io.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pip//pyyaml",
    ],
)

py_test(
    name = "io_test",
    srcs = ["io_test.py"],
    deps = [
        ":io",
        "@pip//pytest",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
