load("//tools/python:defs.bzl", "py_library")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "workspace",
    srcs = ["workspace.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "command",
    srcs = ["command.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "targets",
    srcs = ["targets.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":command",
        ":workspace",
    ],
)

py_library(
    name = "artifacts",
    srcs = ["artifacts.py"],
    visibility = ["//:__subpackages__"],
    deps = [":command"],
)

py_library(
    name = "bep",
    srcs = ["bep.py"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
