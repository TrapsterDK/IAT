{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@apps/*": ["./apps/*", "./bazel-bin/apps/*.d.ts"],
      "@libs/*": ["./libs/*", "./bazel-bin/libs/*.d.ts"]
    }
  },
  "exclude": ["bazel-*", "bazel-bin", "bazel-out", "bazel-testlogs", "node_modules"]
}
