{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@iat/*": [
        "./*.mts",
        "./*.cts",
        "./*.ts",
        "./*.mjs",
        "./*.cjs",
        "./*.js",
        "./bazel-bin/*.d.mts",
        "./bazel-bin/*.d.cts",
        "./bazel-bin/*.d.ts"
      ]
    }
  },
  "exclude": ["bazel-*", "bazel-bin", "bazel-out", "bazel-testlogs", "node_modules"]
}
