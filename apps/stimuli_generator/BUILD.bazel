load("//tools/python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "backend_sd35",
    srcs = ["backend_sd35.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":specs",
        "@pip//diffusers",
        "@pip//pillow",
        "@pip//torch",
    ],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":backend_sd35",
        ":specs",
        "//libs/bazel:workspace",
        "@pip//typer",
    ],
)

py_library(
    name = "specs",
    srcs = ["specs.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//libs/config",
        "//libs/config:extending_config",
        "@pip//pydantic",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
