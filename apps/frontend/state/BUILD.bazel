load("//tools/javascript:defs.bzl", "ts_project")

package(default_visibility = ["//:__subpackages__"])

ts_project(
    name = "state",
    srcs = [
        "automation.mts",
        "block_uploads.mts",
        "runtime.mts",
        "selectors.mts",
        "types.mts",
    ],
    declaration = True,
    tsconfig = "//apps/frontend:tsconfig",
    visibility = ["//:__subpackages__"],
)

ts_project(
    name = "state_tests",
    testonly = True,
    srcs = [
        "automation_test.mts",
        "block_uploads_test.mts",
        "runtime_test.mts",
        "selectors_test.mts",
    ],
    declaration = True,
    tsconfig = "//apps/frontend:tsconfig",
    deps = [
        ":state",
        "//:node_modules/@types/node",
        "//apps/frontend/state/states",
        "//apps/frontend/testing",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
