load("//tools/javascript:defs.bzl", "ts_project")

package(default_visibility = ["//:__subpackages__"])

ts_project(
    name = "states",
    srcs = [
        "block_intro.mts",
        "result.mts",
        "review.mts",
        "trial.mts",
    ],
    declaration = True,
    tsconfig = "//apps/frontend:tsconfig",
    visibility = ["//:__subpackages__"],
    deps = ["//apps/frontend/state"],
)

ts_project(
    name = "states_tests",
    testonly = True,
    srcs = [
        "block_intro_test.mts",
        "result_test.mts",
        "review_test.mts",
        "trial_test.mts",
    ],
    declaration = True,
    tsconfig = "//apps/frontend:tsconfig",
    deps = [
        ":states",
        "//:node_modules/@types/node",
        "//apps/frontend/state",
        "//apps/frontend/testing",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
