load("//tools/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "specs",
    srcs = ["specs.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//libs/config",
        "//libs/config:extending_config",
        "//libs/path",
        "//libs/pydantic:types",
        "@pip//pydantic",
    ],
)

py_library(
    name = "runfiles",
    srcs = ["runfiles.py"],
    data = ["browser/harness.js"],
    visibility = ["//:__subpackages__"],
    deps = ["@pip//bazel_runfiles"],
)

py_library(
    name = "grid",
    srcs = ["grid.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pip//gql",
        "@pip//pydantic",
        "@pip//yarl",
    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":grid",
        ":result_models",
        ":runfiles",
        ":specs",
        "@pip//pydantic",
        "@pip//selenium",
        "@pip//yarl",
    ],
)

py_library(
    name = "result_models",
    srcs = ["result_models.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":specs",
        "//libs/config",
        "@pip//pydantic",
    ],
)

py_library(
    name = "manifest_writer",
    srcs = ["manifest_writer.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":result_models",
        ":specs",
    ],
)

py_library(
    name = "main_lib",
    srcs = ["main.py"],
    deps = [
        ":grid",
        ":manifest_writer",
        ":result_models",
        ":runner",
        ":specs",
        "//libs/bazel:workspace",
        "//libs/path",
        "@pip//typer",
        "@pip//yarl",
    ],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":grid",
        ":manifest_writer",
        ":result_models",
        ":runner",
        ":specs",
        "//libs/bazel:workspace",
        "//libs/path",
        "@pip//typer",
        "@pip//yarl",
    ],
)

py_test(
    name = "specs_test",
    srcs = ["specs_test.py"],
    deps = [
        ":specs",
        "//libs/testing:io",
        "@pip//pydantic",
        "@pip//pytest",
    ],
)

py_test(
    name = "grid_test",
    srcs = ["grid_test.py"],
    deps = [
        ":grid",
        "@pip//pytest",
    ],
)

filegroup(
    name = "readme",
    srcs = ["README.md"],
    tags = ["markdown"],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
