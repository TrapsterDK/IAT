load("//tools/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "iat",
    srcs = ["iat.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//apps/backend:iat_spec",
        "//apps/backend:settings",
    ],
)

py_test(
    name = "iat_test",
    srcs = ["iat_test.py"],
    deps = [
        ":iat",
        "//apps/backend:settings",
        "//libs/testing:io",
        "@pip//pytest",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
