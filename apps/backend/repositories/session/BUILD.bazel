py_library(
    name = "plan",
    srcs = ["plan.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//apps/backend/models:plan",
        "@pip//sqlalchemy",
    ],
)

py_library(
    name = "scoring",
    srcs = ["scoring.py"],
    visibility = ["//:__subpackages__"],
