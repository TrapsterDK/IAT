load("//tools/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "exceptions",
    srcs = ["exceptions.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "run_plan_builder",
    srcs = ["run_plan_builder.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":exceptions",
        ":models",
        "//apps/backend/domain/iat:models",
    ],
)

py_library(
    name = "execution",
    srcs = ["execution.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":exceptions",
        ":models",
    ],
)

py_test(
    name = "run_plan_builder_test",
    srcs = ["run_plan_builder_test.py"],
    deps = [
        ":exceptions",
        ":models",
        ":run_plan_builder",
        "//apps/backend:conftest",
        "//apps/backend/domain/iat:models",
        "@pip//pytest",
    ],
)

py_test(
    name = "execution_test",
    srcs = ["execution_test.py"],
    deps = [
        ":exceptions",
        ":execution",
        ":models",
        "//apps/backend:conftest",
        "@pip//pytest",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
