load("//tools/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "exceptions",
    srcs = ["exceptions.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "run_plan_builder",
    srcs = ["run_plan_builder.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":exceptions",
        "//apps/backend/models:catalog",
        "//apps/backend/models:plan",
    ],
)

py_library(
    name = "scoring",
    srcs = ["scoring.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":exceptions",
        "//apps/backend/models:scoring",
    ],
)

py_test(
    name = "run_plan_builder_test",
    srcs = ["run_plan_builder_test.py"],
    deps = [
        ":run_plan_builder",
        "//apps/backend:conftest",
        "//apps/backend/models:catalog",
        "//apps/backend/models:plan",
    ],
)

py_test(
    name = "scoring_test",
    srcs = ["scoring_test.py"],
    deps = [
        ":exceptions",
        ":scoring",
        "//apps/backend:conftest",
        "//apps/backend/models:plan",
        "//apps/backend/models:scoring",
        "//apps/backend/models:session",
        "@pip//pytest",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
