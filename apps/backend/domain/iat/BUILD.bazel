load("//tools/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "spec_models",
    srcs = ["spec_models.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//libs/config",
        "//libs/path",
        "//libs/pydantic:types",
        "@pip//pydantic",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//:__subpackages__"],
)

py_test(
    name = "spec_models_test",
    srcs = ["spec_models_test.py"],
    deps = [
        ":spec_models",
        "//apps/backend:conftest",
        "//libs/testing:io",
        "@pip//pydantic",
        "@pip//pytest",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
