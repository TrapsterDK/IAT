load("//tools/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "iat",
    srcs = ["iat.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//libs/pydantic:types",
        "@pip//pydantic",
    ],
)

py_library(
    name = "session",
    srcs = ["session.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//apps/backend/domain/session:models",
        "//libs/pydantic:types",
        "@pip//pydantic",
    ],
)

py_test(
    name = "iat_test",
    srcs = ["iat_test.py"],
    deps = [
        ":iat",
        "//apps/backend:conftest",
        "@pip//pydantic",
        "@pip//pytest",
    ],
)

py_test(
    name = "session_test",
    srcs = ["session_test.py"],
    deps = [
        ":session",
        "//apps/backend:conftest",
        "@pip//pydantic",
        "@pip//pytest",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
