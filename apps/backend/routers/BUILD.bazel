load("//tools/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "iats",
    srcs = ["iats.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//apps/backend:dependencies",
        "//apps/backend:models",
        "//apps/backend/repositories:iat",
        "//apps/backend/services:iat",
        "@pip//fastapi",
    ],
)

py_library(
    name = "stimuli",
    srcs = ["stimuli.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//apps/backend:dependencies",
        "//apps/backend/services:iat",
        "@pip//fastapi",
    ],
)

py_test(
    name = "iats_test",
    srcs = ["iats_test.py"],
    deps = [
        ":iats",
        ":stimuli",
        "//apps/backend:dependencies",
        "//apps/backend:settings",
        "//apps/backend/repositories:iat",
        "//apps/backend/services:iat",
        "//libs/testing:io",
        "//third_party/python/fastapi:testclient",
        "@pip//fastapi",
    ],
)

py_test(
    name = "stimuli_test",
    srcs = ["stimuli_test.py"],
    deps = [
        ":stimuli",
        "//apps/backend:dependencies",
        "//apps/backend:settings",
        "//apps/backend/repositories:iat",
        "//apps/backend/services:iat",
        "//libs/testing:io",
        "//third_party/python/fastapi:testclient",
        "@pip//fastapi",
        "@pip//httpx",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
