load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("//tools/python:defs.bzl", "py_binary")

package(default_visibility = ["//:__subpackages__"])

py_console_script_binary(
    name = "yamllint",
    pkg = "@pip//yamllint:pkg",
)

py_binary(
    name = "pydoclint",
    srcs = ["pydoclint_wrapper.py"],
    main = "pydoclint_wrapper.py",
    visibility = ["//:__subpackages__"],
    deps = ["@pip//pydoclint"],
)

eslint_bin.eslint_binary(name = "eslint")

copy_to_directory(
    name = "vale_styles",
    srcs = [
        "//.vale:IAT",
        "//.vale:config",
        "@vale_Google//:Google",
        "@vale_write-good//:write-good",
    ],
    include_external_repositories = ["*vale_*"],
    root_paths = [".vale"],
)

native_binary(
    name = "vale",
    src = select(
        {
            "@bazel_tools//src/conditions:darwin_arm64": "@vale_macOS_arm64//:vale",
            "@bazel_tools//src/conditions:darwin_x86_64": "@vale_macOS_64-bit//:vale",
            "@bazel_tools//src/conditions:linux_aarch64": "@vale_Linux_arm64//:vale",
            "@bazel_tools//src/conditions:linux_x86_64": "@vale_Linux_64-bit//:vale",
            "@bazel_tools//src/conditions:windows_x64": "@vale_Windows_64-bit//:vale.exe",
        },
    ),
    out = "vale",
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "@aspect_rules_lint//lint:buildifier",
        "@aspect_rules_lint//lint:eslint",
        "@aspect_rules_lint//lint:pydoclint",
        "@aspect_rules_lint//lint:ruff",
        "@aspect_rules_lint//lint:ty",
        "@aspect_rules_lint//lint:vale",
        "@aspect_rules_lint//lint:yamllint",
    ],
)

filegroup(
    name = "build_bazel",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
